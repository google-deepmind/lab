http_archive(
    name = "com_google_absl",
    urls = ["https://github.com/abseil/abseil-cpp/releases/download/20240722.0/abseil-cpp-20240722.0.tar.gz"],
    sha256 = "f50e5ac311a81382da7fa75b97310e4b9006474f9560ac46f54a9967f07d4ae3",
    strip_prefix = "abseil-cpp-20240722.0",
patch_cmds = ["""
python3 - <<'PY'
from pathlib import Path

rules = {
    "cc_library": "cc_library",
    "cc_test": "cc_test",
    "cc_binary": "cc_binary",
}

newline = chr(10)
count = 0

for path in Path(".").rglob("*"):
    if not path.is_file() or path.name not in ("BUILD", "BUILD.bazel"):
        continue

    content = path.read_text()
    lines = content.splitlines()

    additions = []
    for rule, filename in rules.items():
        if rule + "(" in content and filename + ".bzl" not in content:
            additions.append(
                'load("@rules_cc//cc:' + filename + '.bzl", "' + rule + '")'
            )

    if not additions:
        continue

    index = next(
        (i for i, line in enumerate(lines)
         if line.startswith(("load(", "package("))),
        0
    )

    lines[index:index] = additions + [""]
    path.write_text(newline.join(lines) + newline)
    count += 1

print("Updated", count, "Abseil BUILD files")
PY
"""],
)

